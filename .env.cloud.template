BASE_URL="http://localhost:4000"

# For local development, run `yarn db:provision` and paste the URLs it prints.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/customermates"
# Optional when migrations should bypass a connection pooler; use the printed DIRECT_URL locally.
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/customermates"

BETTER_AUTH_SECRET="XXX"

# Optional: route Preview OAuth callbacks through the production origin.
# OAUTH_PROXY_URL="https://app.example.com"
# OAUTH_PROXY_SECRET="XXX"

RESEND_API_KEY="XXX"
RESEND_OPERATOR_EMAIL="XXX"

CRON_SECRET="XXX"

# Error reports use native capture, Vercel logs and Workflow/Resend notifications.
NEXT_PUBLIC_ERROR_REPORTING_PROVIDER="vercel"
# Required for hosted email alerts (server only).
# ERROR_REPORTING_NOTIFICATION_EMAIL=""
# Emails per UTC day and instance, one per distinct error (default 10, 0 disables); keeps alerts within the Resend quota.
# ERROR_REPORTING_NOTIFICATION_DAILY_LIMIT="10"

GOOGLE_CLIENT_ID="XXX"
GOOGLE_CLIENT_SECRET="XXX"
AZURE_AD_CLIENT_ID="XXX"
AZURE_AD_CLIENT_SECRET="XXX"

APP_MODE="cloud"

# Fails closed and accepts only the literal values "true" or "false".
HOSTED_AI_OPERATOR_CONTROLS_ENABLED="false"
# Fleet-wide hosted-AI admission. Both apply only while the controls above are enabled.
# Pausing refuses every hosted-AI round for every customer.
HOSTED_AI_PROVIDER_WORK_PAUSED="false"
# Monthly hosted-AI spend ceiling in microcents. Leave unset to refuse all hosted-AI spend.
HOSTED_AI_MONTHLY_SPEND_CAP_MICROCENTS=""

# Offline conversion upload to Google Ads through the Data Manager API. Off unless ENABLED is "true";
# requests are validate-only (nothing is imported) unless INGEST is also "true". Validate-only requests still
# transmit each conversion's gclid to Google for checking. Names only, no values in git.
GOOGLE_ADS_CONVERSION_UPLOAD_ENABLED="false"
GOOGLE_ADS_CONVERSION_UPLOAD_INGEST="false"
GOOGLE_ADS_OPERATING_ACCOUNT_ID=""
GOOGLE_ADS_LOGIN_ACCOUNT_ID=""
GOOGLE_ADS_SIGNUP_CONVERSION_ACTION_ID=""
GOOGLE_ADS_PAID_CONVERSION_ACTION_ID=""
GOOGLE_DATA_MANAGER_CLIENT_ID=""
GOOGLE_DATA_MANAGER_CLIENT_SECRET=""
GOOGLE_DATA_MANAGER_REFRESH_TOKEN=""

# Cloud and demo refuse webhook deliveries to loopback, private and link-local addresses.
# Accepts only "true" or "false"; set "true" only to deliver to a receiver on this machine during development.
WEBHOOK_ALLOW_PRIVATE_DESTINATIONS="false"

LEMONSQUEEZY_API_KEY="XXX"
LEMONSQUEEZY_WEBHOOK_SECRET="XXX"
LEMONSQUEEZY_STORE_ID="XXX"
# Monthly per-seat offer bindings. Annual checkout is intentionally unavailable.
LEMONSQUEEZY_VARIANT_ID_STARTER="XXX"
LEMONSQUEEZY_VARIANT_ID_PRO="XXX"
LEMONSQUEEZY_VARIANT_ID_BUSINESS="XXX"
LEMONSQUEEZY_VARIANT_ID_MAX="XXX"
UNIPILE_API_KEY="XXX"
UNIPILE_WEBHOOK_SECRET="XXX"
UNIPILE_HOSTED_AUTH_DOMAIN="auth.customermates.com"

# The workflow world's Postgres pool must be at least its queue concurrency (50).
# Leaving it at the pg default of 10 makes durable steps wait for a free connection,
# which surfaces as agent turns hanging for tens of minutes under load.
WORKFLOW_POSTGRES_MAX_POOL_SIZE="50"

AI_GATEWAY_API_KEY="XXX"
# AGENT_CHAT_DISABLED="true"

# File fields: database (default), s3 or vercel-blob. Maximum file size in bytes; default 1073741824 (1 GB).
FILE_STORAGE_DRIVER=""
FILE_MAX_UPLOAD_BYTES=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""
# Postal codes for city and region suggestions: unset loads them from GeoNames, "off" turns this off, a URL sets a mirror.
POSTAL_CODE_DATA_URL=""
