# Copy this file to .env for local development or self-hosting.
# Replace the disposable values before exposing an instance publicly.

# Application
BASE_URL=http://localhost:4000
BETTER_AUTH_SECRET=local-development-only-change-me
APP_MODE=self-hosted
APP_PORT=4000

# Postgres service (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=customermates

# Local PostgreSQL connection used by the application and Prisma.
# Docker Compose derives both in-container database connections from POSTGRES_* above.
DATABASE_URL=postgresql://postgres:password@localhost:5433/customermates
# Optional direct connection for Prisma when DATABASE_URL points through a connection pooler.
# DIRECT_URL=

# Email
RESEND_API_KEY=
RESEND_OPERATOR_EMAIL=

# Optional OAuth providers (configure both values in a pair)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# Optional Sentry build/runtime integration
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional hosted integrations
# CRON_SECRET=
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID_STARTER=
# LEMONSQUEEZY_VARIANT_ID_PRO=
# LEMONSQUEEZY_VARIANT_ID_BUSINESS=
# UNIPILE_API_KEY=
# UNIPILE_WEBHOOK_SECRET=
# UNIPILE_HOSTED_AUTH_DOMAIN=

# Hosted-image build setting for origins that may embed the app. Defaults to same-origin only.
# Prebuilt self-hosted images must replace the CSP header at their reverse proxy instead.
# FRAME_ANCESTORS=https://portal.example.com
