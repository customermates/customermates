{
  "buildCommand": "yarn vercel-build",
  "crons": [
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reprocess-webhook-events",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/routines",
      "schedule": "*/5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ],
      "source": "/.well-known/microsoft-identity-association.json"
    }
  ]
}
