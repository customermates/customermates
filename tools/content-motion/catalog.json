{
  "version": 3,
  "schemaVersion": 3,
  "layers": ["foundation", "primitive", "molecule", "pattern", "scene"],
  "layout": {
    "spaceTokens": {
      "none": 0,
      "2xs": 4,
      "xs": 8,
      "sm": 12,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48
    },
    "spacingRecipes": {
      "product": {
        "surfaceInset": 24,
        "sectionGap": 24,
        "fieldGap": 16,
        "labelGap": 8,
        "inlineGap": 12,
        "singleLineControlHeight": 36,
        "controlFontSize": 14,
        "controlLineHeight": 20
      },
      "social-form": {
        "surfaceInset": 48,
        "sectionGap": 32,
        "fieldGap": 24,
        "labelGap": 8,
        "inlineGap": 16,
        "singleLineControlHeight": 56,
        "controlFontSize": 22,
        "controlLineHeight": 28
      },
      "social-hero-form": {
        "surfaceInset": 48,
        "sectionGap": 32,
        "fieldGap": 24,
        "labelGap": 8,
        "inlineGap": 16,
        "singleLineControlHeight": 64,
        "controlFontSize": 28,
        "controlLineHeight": 36
      }
    },
    "flowPrimitives": ["group", "stack", "inline", "grid"],
    "widthTokens": ["full", "half", "third", "content"],
    "adaptiveSurface": {
      "axis": "height",
      "anchors": ["top", "center"],
      "bounds": ["min", "max", "inset"],
      "rule": "Visible product leaves determine the rendered height inside declared bounds; focus and connectors do not affect sizing."
    },
    "rule": "Only top-level stages may use free x/y geometry; component internals use slots, named rhythm recipes, and flow tokens."
  },
  "sceneRecipes": [
    {
      "id": "channel-convergence",
      "layer": "pattern",
      "purpose": "Move several provider tiles toward one persistent customer context without rebuilding the destination UI.",
      "requiredComponents": ["provider-tile", "card"],
      "motionGrammar": ["slide", "fade", "zoom"],
      "continuity": "Provider tiles and the destination card keep stable node ids for the full scene."
    },
    {
      "id": "persistent-customer-action",
      "layer": "story",
      "purpose": "Show an agent command causing an observable product-state change on one customer record.",
      "requiredComponents": ["card", "status-swap", "counter", "focus"],
      "motionGrammar": ["zoom", "fade"],
      "continuity": "The record remains mounted while focus, status, and action state change in place."
    },
    {
      "id": "progressive-form",
      "layer": "pattern",
      "purpose": "Show a short product form being completed or configured without rebuilding its controls.",
      "requiredComponents": [
        "field",
        "input-control",
        "textarea-control",
        "select-control",
        "checkbox-control",
        "switch-control"
      ],
      "motionGrammar": ["fade", "slide", "focus-pulse"],
      "continuity": "Controls keep stable ids while typed, selected, and boolean values update in place."
    },
    {
      "id": "data-density-switch",
      "layer": "pattern",
      "purpose": "Reuse one compound table anatomy for compact dashboards, comfortable product proof, or social-first rows.",
      "requiredComponents": ["data-table", "table-row", "table-cell"],
      "motionGrammar": ["fade", "zoom", "directional-wipe"],
      "continuity": "The table recipe changes presentation and content, not cell geometry or component implementation."
    },
    {
      "id": "tabbed-detail",
      "layer": "pattern",
      "purpose": "Show multiple bounded product views through product-native tabs while keeping one outer surface.",
      "requiredComponents": [
        "tabs",
        "tabs-list",
        "tab-trigger",
        "tabs-content"
      ],
      "motionGrammar": ["fade", "slide"],
      "continuity": "Each tab and content region is individually addressable and shares one Tabs root."
    },
    {
      "id": "progressive-disclosure",
      "layer": "pattern",
      "purpose": "Compress supporting account evidence into one controlled product-native disclosure surface.",
      "requiredComponents": [
        "accordion",
        "accordion-item",
        "accordion-trigger",
        "accordion-content"
      ],
      "motionGrammar": ["fade", "slide", "focus-pulse"],
      "continuity": "Accordion items remain mounted while one controlled value reveals the selected evidence."
    },
    {
      "id": "bounded-decision",
      "layer": "pattern",
      "purpose": "Make one routing choice and one enabled rule legible without creating a custom settings card.",
      "requiredComponents": ["radio-group", "radio-item", "toggle"],
      "motionGrammar": ["fade", "focus-pulse"],
      "continuity": "Selection and pressed state derive from frame actions on stable product controls."
    }
  ],
  "components": [
    {
      "id": "text",
      "layer": "primitive",
      "nodeType": "text",
      "source": "styles/globals.css",
      "variants": [
        "display",
        "title",
        "ui",
        "body",
        "muted",
        "eyebrow",
        "mono",
        "label"
      ],
      "presentations": ["product", "social", "social-hero"],
      "states": ["static", "typing"]
    },
    {
      "id": "badge",
      "layer": "primitive",
      "nodeType": "badge",
      "source": "components/ui/badge.tsx",
      "variants": [
        "default",
        "secondary",
        "success",
        "warning",
        "info",
        "outline"
      ],
      "presentations": ["product", "social", "social-hero"],
      "states": ["static"]
    },
    {
      "id": "button",
      "layer": "primitive",
      "nodeType": "button",
      "source": "components/ui/button.tsx",
      "variants": [
        "default",
        "destructive",
        "outline",
        "secondary",
        "ghost",
        "link"
      ],
      "states": ["static"]
    },
    {
      "id": "avatar",
      "layer": "primitive",
      "nodeType": "avatar",
      "source": "components/ui/avatar.tsx",
      "variants": ["sm", "default", "lg", "xl"],
      "presentations": ["product", "social", "social-hero"],
      "states": ["static"]
    },
    {
      "id": "input-control",
      "layer": "primitive",
      "nodeType": "inputControl",
      "source": "components/ui/input.tsx",
      "presentations": ["product", "social", "social-hero"],
      "states": ["value", "placeholder", "typing"]
    },
    {
      "id": "textarea-control",
      "layer": "primitive",
      "nodeType": "textareaControl",
      "source": "components/ui/textarea.tsx",
      "presentations": ["product", "social", "social-hero"],
      "variants": [
        "2-row",
        "3-row",
        "4-row",
        "5-row",
        "6-row",
        "7-row",
        "8-row"
      ],
      "states": ["value", "placeholder", "typing"]
    },
    {
      "id": "select-control",
      "layer": "primitive",
      "nodeType": "selectControl",
      "source": "components/ui/select.tsx",
      "presentations": ["product", "social", "social-hero"],
      "states": ["placeholder", "selected", "updating"]
    },
    {
      "id": "checkbox-control",
      "layer": "primitive",
      "nodeType": "checkboxControl",
      "source": "components/ui/checkbox.tsx",
      "presentations": ["product", "social"],
      "states": ["unchecked", "checked", "updating"]
    },
    {
      "id": "switch-control",
      "layer": "primitive",
      "nodeType": "switchControl",
      "source": "components/ui/switch.tsx",
      "presentations": ["product", "social"],
      "states": ["unchecked", "checked", "updating"]
    },
    {
      "id": "separator",
      "layer": "primitive",
      "nodeType": "separator",
      "source": "components/ui/separator.tsx",
      "variants": ["horizontal", "vertical"],
      "states": ["static"]
    },
    {
      "id": "logo",
      "layer": "primitive",
      "nodeType": "logo",
      "source": "approved local assets",
      "states": ["static"]
    },
    {
      "id": "chip",
      "layer": "molecule",
      "nodeType": "chip",
      "source": "components/chip/app-chip.tsx",
      "presentations": ["product", "social"],
      "variants": [
        "default",
        "secondary",
        "success",
        "warning",
        "info",
        "outline"
      ],
      "states": ["static"]
    },
    {
      "id": "provider-tile",
      "layer": "molecule",
      "nodeType": "providerTile",
      "source": "components/ui/button.tsx",
      "variants": ["icon-sm", "icon", "icon-lg", "hero"],
      "states": ["static"]
    },
    {
      "id": "overlap-stack",
      "layer": "molecule",
      "nodeType": "overlapStack",
      "source": "components/shared/overlapping-stack.tsx",
      "variants": ["default", "sm"],
      "states": ["static", "overflow"]
    },
    {
      "id": "alert",
      "layer": "molecule",
      "nodeType": "alert",
      "source": "components/ui/alert.tsx",
      "variants": ["default", "destructive"],
      "states": ["static"]
    },
    {
      "id": "field",
      "layer": "molecule",
      "nodeType": "field",
      "source": "components/ui/label.tsx + components/ui/input.tsx",
      "anatomy": ["text:label", "inputControl", "text:muted"],
      "states": ["empty", "filled", "typing"]
    },
    {
      "id": "status-swap",
      "layer": "molecule",
      "nodeType": "statusSwap",
      "source": "components/ui/badge.tsx",
      "presentations": ["product", "social", "social-hero"],
      "states": ["initial", "updated", "transition"]
    },
    {
      "id": "counter",
      "layer": "molecule",
      "nodeType": "counter",
      "source": "components/ui/badge.tsx",
      "presentations": ["product", "social", "social-hero"],
      "variants": ["badge", "progress"],
      "states": ["initial", "counting", "complete"]
    },
    {
      "id": "card",
      "layer": "molecule",
      "nodeType": "card",
      "source": "components/ui/card.tsx",
      "anatomy": ["cardHeader", "cardContent", "cardFooter"],
      "presentations": ["product", "social", "hero"],
      "states": ["static", "entering", "focused"]
    },
    {
      "id": "card-header",
      "layer": "primitive",
      "nodeType": "cardHeader",
      "source": "components/ui/card.tsx",
      "allowedChildren": ["text", "cardAction", "badge"]
    },
    {
      "id": "card-action",
      "layer": "primitive",
      "nodeType": "cardAction",
      "source": "components/ui/card.tsx",
      "allowedChildren": ["badge", "button", "counter"]
    },
    {
      "id": "card-content",
      "layer": "primitive",
      "nodeType": "cardContent",
      "source": "components/ui/card.tsx",
      "allowedChildren": [
        "group",
        "stack",
        "inline",
        "grid",
        "field",
        "dataTable",
        "tabs",
        "alert"
      ]
    },
    {
      "id": "card-footer",
      "layer": "primitive",
      "nodeType": "cardFooter",
      "source": "components/ui/card.tsx",
      "allowedChildren": ["inline", "button", "badge", "text"]
    },
    {
      "id": "data-table",
      "layer": "pattern",
      "nodeType": "dataTable",
      "source": "components/ui/table.tsx",
      "anatomy": [
        "tableHeader",
        "tableBody",
        "tableRow",
        "tableHead",
        "tableCell"
      ],
      "presentations": [
        "product",
        "compact",
        "comfortable",
        "social",
        "social-hero"
      ],
      "states": ["static", "updating", "complete"]
    },
    {
      "id": "table-header",
      "layer": "primitive",
      "nodeType": "tableHeader",
      "source": "components/ui/table.tsx",
      "allowedChildren": ["tableRow"]
    },
    {
      "id": "table-body",
      "layer": "primitive",
      "nodeType": "tableBody",
      "source": "components/ui/table.tsx",
      "allowedChildren": ["tableRow"]
    },
    {
      "id": "table-row",
      "layer": "molecule",
      "nodeType": "tableRow",
      "source": "components/ui/table.tsx",
      "allowedChildren": ["tableCell"],
      "states": ["default", "selected", "muted"]
    },
    {
      "id": "table-head",
      "layer": "primitive",
      "nodeType": "tableHead",
      "source": "components/ui/table.tsx",
      "variants": [
        "left:narrow",
        "left:standard",
        "left:wide",
        "left:fill",
        "center:narrow",
        "center:standard",
        "center:wide",
        "center:fill",
        "right:narrow",
        "right:standard",
        "right:wide",
        "right:fill"
      ],
      "states": ["static"]
    },
    {
      "id": "table-cell",
      "layer": "primitive",
      "nodeType": "tableCell",
      "source": "components/ui/table.tsx",
      "variants": [
        "left:narrow",
        "left:standard",
        "left:wide",
        "left:fill",
        "center:narrow",
        "center:standard",
        "center:wide",
        "center:fill",
        "right:narrow",
        "right:standard",
        "right:wide",
        "right:fill"
      ],
      "allowedChildren": [
        "text",
        "inline",
        "stack",
        "avatar",
        "providerTile",
        "badge",
        "statusSwap",
        "button",
        "checkboxControl",
        "switchControl"
      ]
    },
    {
      "id": "tabs",
      "layer": "pattern",
      "nodeType": "tabs",
      "source": "components/ui/tabs.tsx",
      "anatomy": ["tabsList", "tabTrigger", "tabsContent"],
      "variants": ["horizontal", "vertical"],
      "states": ["static"]
    },
    {
      "id": "tabs-list",
      "layer": "molecule",
      "nodeType": "tabsList",
      "source": "components/ui/tabs.tsx",
      "variants": ["default", "line"],
      "allowedChildren": ["tabTrigger"]
    },
    {
      "id": "tab-trigger",
      "layer": "primitive",
      "nodeType": "tabTrigger",
      "source": "components/ui/tabs.tsx",
      "states": ["active", "inactive"]
    },
    {
      "id": "tabs-content",
      "layer": "primitive",
      "nodeType": "tabsContent",
      "source": "components/ui/tabs.tsx",
      "states": ["active", "inactive"]
    },
    {
      "id": "accordion",
      "layer": "pattern",
      "nodeType": "accordion",
      "source": "components/ui/accordion.tsx",
      "anatomy": ["accordionItem", "accordionTrigger", "accordionContent"],
      "states": ["controlled", "collapsed", "expanded"]
    },
    {
      "id": "accordion-item",
      "layer": "molecule",
      "nodeType": "accordionItem",
      "source": "components/ui/accordion.tsx",
      "allowedChildren": ["accordionTrigger", "accordionContent"]
    },
    {
      "id": "accordion-trigger",
      "layer": "primitive",
      "nodeType": "accordionTrigger",
      "source": "components/ui/accordion.tsx",
      "presentations": ["product", "social", "social-hero"],
      "states": ["open", "closed"]
    },
    {
      "id": "accordion-content",
      "layer": "primitive",
      "nodeType": "accordionContent",
      "source": "components/ui/accordion.tsx",
      "states": ["open", "closed"]
    },
    {
      "id": "radio-group",
      "layer": "molecule",
      "nodeType": "radioGroup",
      "source": "components/ui/radio-group.tsx",
      "allowedChildren": ["radioItem"],
      "states": ["controlled"]
    },
    {
      "id": "radio-item",
      "layer": "primitive",
      "nodeType": "radioItem",
      "source": "components/ui/radio-group.tsx",
      "presentations": ["product", "social", "social-hero"],
      "states": ["checked", "unchecked"]
    },
    {
      "id": "toggle",
      "layer": "primitive",
      "nodeType": "toggle",
      "source": "components/ui/toggle.tsx",
      "variants": ["default", "outline"],
      "presentations": ["product", "social", "social-hero"],
      "states": ["off", "on"]
    },
    {
      "id": "focus",
      "layer": "primitive",
      "nodeType": "focus",
      "source": "tools/content-motion/render.tsx",
      "variants": ["primary", "success", "warning"],
      "states": ["hidden", "entering", "visible", "exiting"]
    },
    {
      "id": "connector",
      "layer": "primitive",
      "nodeType": "connector",
      "source": "tools/content-motion/render.tsx",
      "variants": ["primary", "muted", "success"],
      "states": ["static", "revealing"]
    },
    {
      "id": "legacy-input",
      "layer": "molecule",
      "nodeType": "input",
      "source": "components/ui/label.tsx + components/ui/input.tsx",
      "status": "legacy",
      "replacement": "field + inputControl"
    },
    {
      "id": "legacy-table",
      "layer": "pattern",
      "nodeType": "table",
      "source": "components/ui/table.tsx",
      "status": "legacy",
      "replacement": "dataTable compound slots"
    }
  ],
  "motions": [
    { "id": "fade", "fields": ["opacity"], "bounded": true },
    { "id": "slide", "fields": ["x", "y", "opacity"], "bounded": true },
    {
      "id": "zoom",
      "fields": ["scale", "originX", "originY"],
      "bounded": true
    },
    { "id": "blur-reveal", "fields": ["blur", "opacity"], "bounded": true },
    {
      "id": "content-resize",
      "fields": ["width", "height", "x", "y"],
      "bounded": true
    },
    {
      "id": "directional-wipe",
      "fields": ["clipTop", "clipRight", "clipBottom", "clipLeft"],
      "bounded": true
    },
    { "id": "tilt", "fields": ["rotateX", "rotateY"], "bounded": true }
  ],
  "actions": [
    "typeText",
    "typeValue",
    "selectValue",
    "toggleBoolean",
    "setAccordion",
    "selectRadio",
    "swapState",
    "countTo",
    "updateTable"
  ],
  "qa": [
    "bounds",
    "content-clipping",
    "text-paint-clipping",
    "phone-type-floor",
    "camera-target-geometry",
    "content-fill",
    "symmetric-padding",
    "declared-insets",
    "alignment-rails",
    "overlap-contracts",
    "focus-target-geometry",
    "scene-density-budget"
  ]
}
