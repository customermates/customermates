generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  companyId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  authsessions      AuthSession[]
  authaccounts      AuthAccount[]
  oauthapplications OauthApplication[]
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@unique([email])
  @@index([email])
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  authuser  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  configId            String    @default("default")
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([key])
  @@index([referenceId])
}

model OauthApplication {
  id                String             @id
  name              String
  icon              String?
  metadata          String?
  clientId          String             @unique
  clientSecret      String?
  redirectUrls      String
  type              String
  disabled          Boolean?           @default(false)
  userId            String?
  authuser          AuthUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@index([userId])
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  oauthapplication      OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  authuser              AuthUser?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OauthConsent {
  id               String           @id
  clientId         String
  oauthapplication OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  authuser         AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes           String
  consentGiven     Boolean
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
}

model User {
  id                              String                    @id @default(uuid())
  email                           String                    @unique
  firstName                       String
  lastName                        String
  companyId                       String
  roleId                          String?
  role                            UserRole?                 @relation(fields: [roleId], references: [id])
  status                          Status                    @default(pendingAuthorization)
  displayLanguage                 Locale                    @default(system)
  formattingLocale                Locale                    @default(system)
  auditLogs                       AuditLog[]
  theme                           Theme                     @default(system)
  country                         CountryCode               @default(de)
  avatarUrl                       String?
  agreeToTerms                    Boolean                   @default(false)
  lastActiveAt                    DateTime?
  welcomeEmailSentAt              DateTime?
  trialExpiredOfferSentAt         DateTime?
  trialInactivationReminderSentAt DateTime?
  trialInactivationNoticeSentAt   DateTime?
  onboardingWizardCompletedAt     DateTime?
  onboardingWizardProgress        Json?
  onboardingWikiStepCompletedAt   DateTime?
  agentCreditActivatedAt          DateTime?
  isPlatformOperator              Boolean                   @default(false)
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  company                         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdTokens                   InviteToken[]             @relation("TokenCreator")
  widgets                         Widget[]
  p13n                            P13n[]
  dataViews                       DataView[]
  connectedAccounts               ConnectedAccount[]
  agentConversations              AgentConversation[]
  agentRunLeases                  AgentRunLease[]
  ownedRoutines                   Routine[]
  agentCreditAdjustments          AgentCreditAdjustment[]
  adAttributions                  AdAttribution[]
  recordAssignments               RecordAssignment[]
  recordEventSubscriptions        RecordEventSubscription[]

  @@unique([companyId, id])
  @@index([companyId])
  @@index([companyId, status])
  @@index([roleId])
}

model Company {
  id                          String                         @id @default(uuid())
  currency                    Currency                       @default(eur)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  tags                        String[]                       @default([])
  users                       User[]
  adAttributions              AdAttribution[]
  conversionEvents            ConversionEvent[]
  inviteTokens                InviteToken[]
  auditLogs                   AuditLog[]
  widgets                     Widget[]
  userRoles                   UserRole[]
  rolePermissions             RolePermission[]
  p13n                        P13n[]
  dataViews                   DataView[]
  webhooks                    Webhook[]
  webhookDeliveries           WebhookDelivery[]
  connectedAccounts           ConnectedAccount[]
  messagingThreads            MessagingThread[]
  messagingMessages           MessagingMessage[]
  messagingThreadParticipants MessagingThreadParticipant[]
  accountActivities           AccountActivity[]
  calendars                   Calendar[]
  calendarEvents              CalendarEvent[]
  subscription                Subscription?
  agentConversations          AgentConversation[]
  agentRunLeases              AgentRunLease[]
  agentRunRounds              AgentRunRound[]
  agentToolReceipts           AgentToolReceipt[]
  agentMessages               AgentMessage[]
  agentUsageEvents            AgentUsageEvent[]
  agentCreditAdjustments      AgentCreditAdjustment[]
  agentTurnRequests           AgentTurnRequest[]
  agentApprovals              AgentApproval[]
  agentUiCommandResults       AgentUiCommandResult[]
  routines                    Routine[]
  routineRuns                 RoutineRun[]
  recordTypes                 RecordTypeDefinition[]
  recordFields                RecordFieldDefinition[]
  recordRelationships         RecordRelationshipDefinition[]
  records                     CrmRecord[]
  recordValues                RecordValue[]
  recordLinks                 RecordLink[]
  recordAssignments           RecordAssignment[]
  recordTypeGrants            RecordTypeGrant[]
  recordSchemaState           RecordSchemaState?
  recordSchemaRevisions       RecordSchemaRevision[]
  recordOperations            RecordOperation[]
  recordStageRows             RecordStageRow[]
  recordMutationReceipts      RecordMutationReceipt[]
  recordEvents                RecordEvent[]
  recordEventSubscriptions    RecordEventSubscription[]
  recordEventMatches          RecordEventMatch[]
  recordIdentities            RecordIdentity[]
  wikiPages                   WikiPage[]
  wikiPageChunks              WikiPageChunk[]
  wikiWebsiteCrawls           WikiWebsiteCrawl[]
  wikiSourceDocuments         WikiSourceDocument[]
}

enum WikiPageKind {
  guide
  procedure
  knowledge
}

model WikiPage {
  id                      String                   @id @default(uuid())
  companyId               String
  title                   String
  markdown                String
  searchVector            Unsupported("tsvector")? @default(dbgenerated("wiki_search_vector(title, markdown)"))
  searchCompact           String?                  @default(dbgenerated("wiki_search_compact(title, markdown)"))
  semanticIndexClaimedAt  DateTime?
  kind                    WikiPageKind             @default(knowledge)
  whenToUse               String?
  sortOrder               Int                      @default(2147483647)
  sourceUrl               String?
  sourceFetchedAt         DateTime?
  sourceContentHash       String?
  sourceImportedUpdatedAt DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks                  WikiPageChunk[]

  @@index([companyId, createdAt, id])
  @@index([companyId, sortOrder, createdAt, id])
  @@index([companyId, kind, title])
  @@index([searchVector], type: Gin)
  @@index([searchCompact(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum WikiWebsiteCrawlStatus {
  queued
  discovering
  fetching
  importing
  synthesizing
  completed
  failed
  blocked
}

model WikiWebsiteCrawl {
  id                String                 @id @default(uuid())
  companyId         String
  userId            String
  clientRequestId   String
  workflowRunId     String?
  homepageUrl       String
  registrableDomain String
  locale            String
  mode              String                 @default("initial")
  status            WikiWebsiteCrawlStatus @default(queued)
  extraHosts        String[]
  pendingHosts      String[]
  targets           Json?
  crawlDelayMs      Int                    @default(0)
  discovered        Int                    @default(0)
  fetched           Int                    @default(0)
  failed            Int                    @default(0)
  importedPages     Int                    @default(0)
  topics            Json?
  failureReason     String?
  startedAt         DateTime               @default(now())
  finishedAt        DateTime?
  updatedAt         DateTime               @updatedAt
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sources           WikiSourceDocument[]

  @@unique([companyId, clientRequestId])
  @@index([companyId, startedAt])
}

model WikiSourceDocument {
  id              String           @id @default(uuid())
  crawlId         String
  companyId       String
  url             String
  canonicalUrl    String
  category        String
  title           String
  text            String
  qaPairs         Json?
  contentHash     String
  fetchedAt       DateTime         @default(now())
  importClaimedAt DateTime?
  crawl           WikiWebsiteCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([crawlId, canonicalUrl])
  @@index([companyId, crawlId])
}

model WikiPageChunk {
  id            String                      @id @default(uuid())
  companyId     String
  pageId        String
  ordinal       Int
  offset        Int
  section       String?
  contentHash   String
  model         String
  pageUpdatedAt DateTime
  embedding     Unsupported("vector(768)")?
  createdAt     DateTime                    @default(now())
  company       Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  page          WikiPage                    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, ordinal])
  @@index([companyId, pageId])
}

model DocsChunk {
  id           String                      @id @default(uuid())
  buildHash    String
  locale       String
  source       String
  slug         String
  sectionOrder Int
  chunkOrdinal Int
  charOffset   Int
  anchor       String
  pageTitle    String
  headingPath  String[]
  label        String
  body         String
  contentHash  String
  searchVector Unsupported("tsvector")?    @default(dbgenerated("docs_search_vector(locale, label, body)"))
  model        String?
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime                    @default(now())

  @@unique([buildHash, locale, source, slug, sectionOrder, chunkOrdinal], map: "DocsChunk_build_chunk_key")
  @@index([contentHash])
  @@index([searchVector], type: Gin)
}

model HostedAiPlatformUsage {
  id             String   @id @default(uuid())
  purpose        String
  accrualMonth   DateTime
  model          String
  inputTokens    Int      @default(0)
  costMicrocents BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([purpose, accrualMonth])
}

model P13n {
  viewStateKeys    Json?
  id               String   @id @default(uuid())
  userId           String
  companyId        String
  p13nId           String
  filters          Json?
  searchTerm       String?
  sortDescriptor   Json?
  pagination       Json?
  columnOrder      String[]
  columnWidths     Json?
  hiddenColumns    String[]
  viewMode         String?  @default("table")
  groupingColumnId String?
  grouping         Json?
  detailOptions    Json?
  settings         Json?
  activeViewKey    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, p13nId])
  @@index([companyId])
  @@index([userId])
}

model DataView {
  id               String   @id @default(uuid())
  companyId        String
  userId           String
  surfaceKey       String
  name             String
  position         Int      @default(0)
  filters          Json?
  searchTerm       String?
  sortDescriptor   Json?
  viewMode         String?
  groupingColumnId String?
  grouping         Json?
  columnOrder      Json?
  columnWidths     Json?
  hiddenColumns    Json?
  pageSize         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, surfaceKey, userId])
}

model InviteToken {
  id          String   @id @default(uuid())
  token       String   @unique
  companyId   String
  createdById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TokenCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  eventData Json
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId  String

  @@index([event])
  @@index([companyId])
  @@index([userId])
  @@index([entityId])
}

model Widget {
  activityQuery  Json?
  measure        Json?
  version        Int        @default(1)
  id             String     @id @default(uuid())
  userId         String
  companyId      String
  name           String
  kind           WidgetKind @default(chart)
  displayOptions Json?
  layout         Json?
  isTemplate     Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([companyId, isTemplate])
}

model UserRole {
  id               String            @id @default(uuid())
  name             String
  description      String?
  isSystemRole     Boolean           @default(false)
  companyId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users            User[]
  permissions      RolePermission[]
  recordTypeGrants RecordTypeGrant[]

  @@unique([companyId, id])
  @@unique([name, companyId])
  @@index([companyId])
  @@index([companyId, isSystemRole])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  companyId String
  resource  Resource
  action    Action
  createdAt DateTime @default(now())
  role      UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@index([companyId])
  @@index([companyId, resource, action])
  @@index([resource, action])
}

model Webhook {
  id           String            @id @default(uuid())
  url          String
  description  String?
  events       String[]
  secret       String?
  headers      Json?
  bodyTemplate String?
  enabled      Boolean           @default(true)
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deliveries   WebhookDelivery[]

  @@unique([companyId, id])
  @@index([companyId])
}

enum WebhookDeliveryStatus {
  pending
  processing
  success
  failed
}

model WebhookDelivery {
  id                   String                @id @default(uuid())
  url                  String
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event                String
  requestBody          Json
  webhookId            String?
  recordEventId        String?
  admissionKey         String?
  subscriptionRevision Int?
  attempts             Int                   @default(0)
  nextAttemptAt        DateTime?             @default(now())
  leaseToken           String?
  leaseExpiresAt       DateTime?
  webhook              Webhook?              @relation(fields: [companyId, webhookId], references: [companyId, id], onDelete: NoAction)
  recordEvent          RecordEvent?          @relation(fields: [companyId, recordEventId], references: [companyId, id], onDelete: Cascade)
  statusCode           Int?
  responseMessage      String?
  success              Boolean               @default(false)
  status               WebhookDeliveryStatus @default(pending)
  deliveredAt          DateTime?
  createdAt            DateTime              @default(now())

  @@unique([companyId, admissionKey])
  @@index([companyId])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, webhookId, createdAt])
  @@index([companyId, recordEventId])
  @@index([nextAttemptAt, status])
}

model Subscription {
  id                            String             @id @default(uuid())
  companyId                     String             @unique
  company                       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lemonSqueezyId                String?            @unique
  lemonSqueezyVariantId         String?
  status                        SubscriptionStatus @default(trial)
  plan                          SubscriptionPlan   @default(pro)
  quantity                      Int?
  trialEndDate                  DateTime?
  currentPeriodEnd              DateTime?
  agentCreditAnchorAt           DateTime?
  enterpriseAgentCreditsPerUser Int?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([companyId])
  @@index([lemonSqueezyId])
}

model AgentCreditAdjustment {
  id                      String   @id @default(uuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaMicrocents         BigInt
  periodStart             DateTime
  periodEnd               DateTime
  reason                  String?
  operationId             String   @unique
  createdByOperatorUserId String?
  createdAt               DateTime @default(now())

  @@index([companyId, userId, periodStart, periodEnd], map: "AgentCreditAdjustment_period_lookup_idx")
  @@index([companyId, createdAt])
}

model OperatorAuditEvent {
  id              String   @id @default(uuid())
  actorUserId     String
  action          String
  targetCompanyId String?
  targetUserId    String?
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetCompanyId, createdAt])
}

enum Resource {
  dataModel
  users
  company
  api
  auditLog
  inboxMessages
  wiki
  routines
}

enum MessagingThreadState {
  unread
  open
  closed
  spam
}

enum MessagingThreadType {
  single
  group
  channel
}

