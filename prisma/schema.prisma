  identityId   String
  identity     RecordIdentity @relation(fields: [companyId, identityId, channelClass], references: [companyId, id, channelClass], onDelete: Cascade)

  @@id([companyId, channelClass, value])
  @@index([companyId, identityId, channelClass])
}

model RecordValue {
  companyId      String
  typeId         String
  recordId       String
  fieldId        String
  state          String                  @default("missing")
  textValue      String?
  textListValue  String[]                @default([])
  lexicalValue   String?
  decimalValue   Decimal?                @db.Decimal(65, 30)
  currency       String?
  booleanValue   Boolean?
  instantValue   DateTime?               @db.Timestamp(6)
  rangeStart     DateTime?               @db.Timestamp(6)
  rangeEnd       DateTime?               @db.Timestamp(6)
  jsonValue      Json?
  errorCode      String?
  schemaRevision Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  record         CrmRecord               @relation(fields: [companyId, typeId, recordId], references: [companyId, typeId, id], onDelete: Cascade)
  field          RecordFieldDefinition   @relation(fields: [companyId, typeId, fieldId], references: [companyId, typeId, id], onDelete: Cascade)
  dependencies   RecordValueDependency[]

  @@id([companyId, typeId, recordId, fieldId])
  @@index([companyId, typeId, fieldId, recordId])
  @@index([textValue(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([textListValue], type: Gin)
  @@index([companyId, typeId, fieldId, decimalValue, recordId])
  @@index([companyId, typeId, fieldId, instantValue, recordId])
  @@index([companyId, typeId, fieldId, rangeStart, recordId])
  @@index([companyId, typeId, fieldId, rangeEnd, recordId])
  @@index([companyId, typeId, fieldId, booleanValue, recordId])
}

model RecordValueDependency {
  companyId    String
  typeId       String
  recordId     String
  fieldId      String
  sourceTypeId String
  sourceId     String
  value        RecordValue @relation(fields: [companyId, typeId, recordId, fieldId], references: [companyId, typeId, recordId, fieldId], onDelete: Cascade)

  @@id([companyId, typeId, recordId, fieldId, sourceTypeId, sourceId])
  @@index([companyId, sourceTypeId, sourceId])
}

model RecordLink {
  companyId    String
  id           String                       @default(uuid())
  relationId   String
  sourceTypeId String
  sourceId     String
  targetTypeId String
  targetId     String
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relationship RecordRelationshipDefinition @relation(fields: [companyId, relationId, sourceTypeId, targetTypeId], references: [companyId, id, sourceTypeId, targetTypeId], onDelete: Cascade)
  source       CrmRecord                    @relation("RecordLinkSource", fields: [companyId, sourceTypeId, sourceId], references: [companyId, typeId, id], onDelete: Cascade)
  target       CrmRecord                    @relation("RecordLinkTarget", fields: [companyId, targetTypeId, targetId], references: [companyId, typeId, id], onDelete: Cascade)

  @@id([companyId, relationId, id])
  @@unique([companyId, relationId, sourceId, targetId])
  @@index([companyId, sourceTypeId, sourceId, relationId])
  @@index([companyId, targetTypeId, targetId, relationId])
}

model RecordAssignment {
  companyId String
  typeId    String
  recordId  String
  userId    String
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  record    CrmRecord @relation(fields: [companyId, typeId, recordId], references: [companyId, typeId, id], onDelete: Cascade)
  user      User      @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, typeId, recordId, userId])
  @@index([companyId, userId, typeId, recordId])
}

model RecordTypeGrant {
  companyId String
  typeId    String
  roleId    String
  actions   Action[]
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      RecordTypeDefinition @relation(fields: [companyId, typeId], references: [companyId, id], onDelete: Cascade)
  role      UserRole             @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, typeId, roleId])
  @@index([companyId, roleId])
}

model RecordSchemaRevision {
  companyId String
  revision  Int
  actorId   String
  snapshot  Json
  change    Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, revision])
}

model RecordOperation {
  companyId        String
  id               String           @default(uuid())
  userId           String
  kind             String
  state            String           @default("pending")
  expectedRevision Int
  request          Json
  stagedSchema     Json?
  result           Json?
  errorCode        String?
  cursor           Json?
  processed        Int              @default(0)
  total            Int              @default(0)
  leaseUntil       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stageRows        RecordStageRow[]

  @@id([companyId, id])
  @@index([companyId, state, createdAt])
  @@index([state, leaseUntil])
}

model RecordStageRow {
  companyId   String
  operationId String
  kind        String
  key         String
  payload     Json
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operation   RecordOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, operationId, kind, key])
}

model RecordMutationReceipt {
  companyId      String
  userId         String
  idempotencyKey String
  requestHash    String
  result         Json
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, userId, idempotencyKey])
}

model RecordEvent {
  companyId         String
  id                String             @default(uuid())
  typeId            String
  recordId          String
  actorId           String
  causeId           String
  kind              String
  payload           Json
  createdAt         DateTime           @default(now())
  deliveredAt       DateTime?
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now())
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matches           RecordEventMatch[]
  webhookDeliveries WebhookDelivery[]
  lastFailureCode   String?

  @@id([companyId, id])
  @@index([companyId, typeId, recordId, createdAt])
  @@index([deliveredAt, nextAttemptAt])
}

// Shared record-trigger configuration. The owning routine or webhook retains its
// own lifecycle; a revision change invalidates already captured pending matches.
model RecordEventSubscription {
  companyId       String
  id              String
  kind            String
  ownerUserId     String
  typeId          String?
  events          String[]
  changedFieldIds String[]
  query           Json?
  sources         Json?
  revision        Int                   @default(1)
  enabled         Boolean               @default(true)
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner           User                  @relation(fields: [companyId, ownerUserId], references: [companyId, id], onDelete: Cascade)
  type            RecordTypeDefinition? @relation(fields: [companyId, typeId], references: [companyId, id], onDelete: Restrict)
  matches         RecordEventMatch[]

  @@id([companyId, id])
  @@index([companyId, enabled, typeId])
  @@index([companyId, ownerUserId])
}

model RecordEventMatch {
  companyId            String
  eventId              String
  subscriptionId       String
  subscriptionRevision Int
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event                RecordEvent             @relation(fields: [companyId, eventId], references: [companyId, id], onDelete: Cascade)
  subscription         RecordEventSubscription @relation(fields: [companyId, subscriptionId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, eventId, subscriptionId])
  @@index([companyId, subscriptionId])
}

model HostedAiPlatformReservation {
  id                 String   @id @default(uuid())
  purpose            String
  model              String
  reservedMicrocents BigInt
  createdAt          DateTime @default(now())
}
