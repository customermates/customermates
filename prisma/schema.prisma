generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  companyId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  authsessions      AuthSession[]
  authaccounts      AuthAccount[]
  oauthapplications OauthApplication[]
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@unique([email])
  @@index([email])
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  authuser  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  configId            String    @default("default")
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([key])
  @@index([referenceId])
}

model OauthApplication {
  id                String             @id
  name              String
  icon              String?
  metadata          String?
  clientId          String             @unique
  clientSecret      String?
  redirectUrls      String
  type              String
  disabled          Boolean?           @default(false)
  userId            String?
  authuser          AuthUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@index([userId])
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  oauthapplication      OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  authuser              AuthUser?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OauthConsent {
  id               String           @id
  clientId         String
  oauthapplication OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  authuser         AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes           String
  consentGiven     Boolean
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
}

model User {
  id                              String             @id @default(uuid())
  email                           String             @unique
  firstName                       String
  lastName                        String
  companyId                       String
  roleId                          String?
  role                            UserRole?          @relation(fields: [roleId], references: [id])
  status                          Status             @default(pendingAuthorization)
  displayLanguage                 Locale             @default(system)
  formattingLocale                Locale             @default(system)
  auditLogs                       AuditLog[]
  theme                           Theme              @default(system)
  country                         CountryCode        @default(de)
  avatarUrl                       String?
  agreeToTerms                    Boolean            @default(false)
  lastActiveAt                    DateTime?
  welcomeEmailSentAt              DateTime?
  trialExpiredOfferSentAt         DateTime?
  trialInactivationReminderSentAt DateTime?
  trialInactivationNoticeSentAt   DateTime?
  onboardingWizardCompletedAt     DateTime?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  company                         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdTokens                   InviteToken[]      @relation("TokenCreator")
  deals                           DealUser[]
  contacts                        ContactUser[]
  organizations                   OrganizationUser[]
  services                        ServiceUser[]
  tasks                           TaskUser[]
  relatedTasks                    Task[]             @relation("TaskRelatedUser")
  widgets                         Widget[]
  p13n                            P13n[]
  connectedAccounts               ConnectedAccount[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([roleId])
}

model Company {
  id                          String                       @id @default(uuid())
  currency                    Currency                     @default(eur)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  tasks                       Task[]
  users                       User[]
  inviteTokens                InviteToken[]
  contacts                    Contact[]
  organizations               Organization[]
  deals                       Deal[]
  services                    Service[]
  CustomColumn                CustomColumn[]
  auditLogs                   AuditLog[]
  customFieldValues           CustomFieldValue[]
  serviceDeals                ServiceDeal[]
  dealOrganizations           DealOrganization[]
  dealUsers                   DealUser[]
  dealContacts                DealContact[]
  contactUsers                ContactUser[]
  contactOrganizations        ContactOrganization[]
  organizationUsers           OrganizationUser[]
  serviceUsers                ServiceUser[]
  taskUsers                   TaskUser[]
  taskContacts                TaskContact[]
  taskOrganizations           TaskOrganization[]
  taskDeals                   TaskDeal[]
  taskServices                TaskService[]
  widgets                     Widget[]
  userRoles                   UserRole[]
  rolePermissions             RolePermission[]
  p13n                        P13n[]
  webhooks                    Webhook[]
  webhookDeliveries           WebhookDelivery[]
  connectedAccounts           ConnectedAccount[]
  messagingThreads            MessagingThread[]
  messagingMessages           MessagingMessage[]
  messagingThreadParticipants MessagingThreadParticipant[]
  accountActivities           AccountActivity[]
  contactIdentifiers          ContactIdentifier[]
  calendars                   Calendar[]
  calendarEvents              CalendarEvent[]
  subscription                Subscription?
  entityTerminology           EntityTerminology[]
}

model EntityTerminology {
  id         String     @id @default(uuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType EntityType
  presetKey  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([companyId, entityType])
  @@index([companyId])
}

model P13n {
  id                 String   @id @default(uuid())
  userId             String
  companyId          String
  p13nId             String
  filters            Json?
  savedFilterPresets Json?
  searchTerm         String?
  sortDescriptor     Json?
  pagination         Json?
  columnOrder        String[]
  columnWidths       Json?
  hiddenColumns      String[]
  viewMode           String?  @default("table")
  groupingColumnId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, p13nId])
  @@index([companyId])
  @@index([userId])
}

model Task {
  id                String             @id @default(uuid())
  type              TaskType
  companyId         String
  name              String
  relatedUserId     String?
  notes             Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relatedUser       User?              @relation("TaskRelatedUser", fields: [relatedUserId], references: [id])
  users             TaskUser[]
  contacts          TaskContact[]
  organizations     TaskOrganization[]
  deals             TaskDeal[]
  services          TaskService[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([type, companyId])
  @@index([relatedUserId])
}

model InviteToken {
  id          String   @id @default(uuid())
  token       String   @unique
  companyId   String
  createdById String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TokenCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  eventData Json
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId  String

  @@index([event])
  @@index([companyId])
  @@index([userId])
  @@index([entityId])
  @@index([companyId, event, entityId, userId])
}

model Contact {
  id                String                @id @default(uuid())
  firstName         String
  lastName          String
  companyId         String
  avatarUrl         String?
  notes             Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizations     ContactOrganization[]
  users             ContactUser[]
  deals             DealContact[]
  tasks             TaskContact[]
  customFieldValues CustomFieldValue[]
  identifiers       ContactIdentifier[]

  @@index([companyId])
  @@index([firstName])
  @@index([lastName])
}

model Organization {
  id                String                @id @default(uuid())
  name              String
  companyId         String
  notes             Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts          ContactOrganization[]
  deals             DealOrganization[]
  users             OrganizationUser[]
  tasks             TaskOrganization[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([name])
}

model CustomColumn {
  id               String             @id @default(uuid())
  label            String
  type             CustomColumnType
  entityType       EntityType
  options          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  companyId        String
  Company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  CustomFieldValue CustomFieldValue[]

  @@index([companyId])
  @@index([companyId, entityType])
}

model CustomFieldValue {
  id             String           @id @default(uuid())
  entityType     EntityType
  columnId       String
  value          String?
  rangeStart     String?          @default(dbgenerated("custom_field_range_start(value)"))
  rangeEnd       String?          @default(dbgenerated("custom_field_range_end(value)"))
  numericValue   Decimal?         @db.Decimal(20, 4)
  type           CustomColumnType
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  column         CustomColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([entityType, columnId])
  @@index([columnId])
  @@index([columnId, value])
  @@index([value])
  @@index([rangeStart])
  @@index([rangeEnd])
  @@index([companyId])
  @@index([contactId])
  @@index([organizationId])
  @@index([dealId])
  @@index([serviceId])
  @@index([taskId])
}

model Deal {
  id                String             @id @default(uuid())
  name              String
  totalValue        Float              @default(0)
  totalQuantity     Float              @default(0)
  companyId         String
  notes             Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizations     DealOrganization[]
  users             DealUser[]
  contacts          DealContact[]
  services          ServiceDeal[]
  tasks             TaskDeal[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([name])
  @@index([createdAt])
  @@index([totalValue])
  @@index([totalQuantity])
}

model Service {
  id                String             @id @default(uuid())
  name              String
  amount            Float
  companyId         String
  notes             Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             ServiceUser[]
  deals             ServiceDeal[]
  tasks             TaskService[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([name])
}

model ServiceDeal {
  id        String   @id @default(uuid())
  serviceId String
  dealId    String
  quantity  Float    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dealId])
  @@index([dealId])
  @@index([serviceId])
  @@index([companyId])
}

model ServiceUser {
  id        String   @id @default(uuid())
  serviceId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([serviceId])
  @@index([userId])
  @@index([companyId])
}

model DealOrganization {
  id             String       @id @default(uuid())
  dealId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, organizationId])
  @@index([dealId])
  @@index([organizationId])
  @@index([companyId])
}

model DealUser {
  id        String   @id @default(uuid())
  dealId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
  @@index([companyId])
}

model DealContact {
  id        String   @id @default(uuid())
  dealId    String
  contactId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
}

model ContactUser {
  id        String   @id @default(uuid())
  contactId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@index([contactId])
  @@index([userId])
  @@index([companyId])
}

model OrganizationUser {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([companyId])
}

model TaskUser {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([companyId])
}

model TaskContact {
  id        String   @id @default(uuid())
  taskId    String
  contactId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([taskId, contactId])
  @@index([taskId])
  @@index([contactId])
  @@index([companyId])
}

model TaskOrganization {
  id             String       @id @default(uuid())
  taskId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([taskId, organizationId])
  @@index([taskId])
  @@index([organizationId])
  @@index([companyId])
}

model TaskDeal {
  id        String   @id @default(uuid())
  taskId    String
  dealId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([taskId, dealId])
  @@index([taskId])
  @@index([dealId])
  @@index([companyId])
}

model TaskService {
  id        String   @id @default(uuid())
  taskId    String
  serviceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([taskId, serviceId])
  @@index([taskId])
  @@index([serviceId])
  @@index([companyId])
}

model ContactOrganization {
  id             String       @id @default(uuid())
  contactId      String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, organizationId])
  @@index([contactId])
  @@index([organizationId])
  @@index([companyId])
}

model Widget {
  id                    String            @id @default(uuid())
  userId                String
  companyId             String
  name                  String
  entityType            EntityType
  entityFilters         Json?
  dealFilters           Json?
  displayOptions        Json?
  groupByType           WidgetGroupByType
  groupByCustomColumnId String?           @db.Uuid
  aggregationType       AggregationType
  layout                Json?
  isTemplate            Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([companyId, isTemplate])
  @@index([companyId, entityType])
}

model UserRole {
  id           String           @id @default(uuid())
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  companyId    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([name, companyId])
  @@index([companyId])
  @@index([companyId, isSystemRole])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  companyId String
  resource  Resource
  action    Action
  createdAt DateTime @default(now())
  role      UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@index([companyId])
  @@index([companyId, resource, action])
  @@index([resource, action])
}

model Webhook {
  id          String   @id @default(uuid())
  url         String
  description String?
  events      String[]
  secret      String?
  enabled     Boolean  @default(true)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

enum WebhookDeliveryStatus {
  pending
  processing
  success
  failed
}

model WebhookDelivery {
  id              String                @id @default(uuid())
  url             String
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event           String
  requestBody     Json
  statusCode      Int?
  responseMessage String?
  success         Boolean               @default(false)
  status          WebhookDeliveryStatus @default(pending)
  deliveredAt     DateTime?
  createdAt       DateTime              @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model Subscription {
  id                    String             @id @default(uuid())
  companyId             String             @unique
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lemonSqueezyId        String?            @unique
  lemonSqueezyVariantId String?
  status                SubscriptionStatus @default(trial)
  plan                  SubscriptionPlan   @default(pro)
  quantity              Int?
  trialEndDate          DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([companyId])
  @@index([lemonSqueezyId])
}

enum Resource {
  contacts
  deals
  organizations
  services
  users
  company
  tasks
  api
  auditLog
  inboxMessages
}

enum MessagingThreadState {
  unread
  open
  closed
  spam
}

enum MessagingThreadType {
  single
  group
  channel
}

enum Action {
  create
  readOwn
  readAll
  update
  delete
}

