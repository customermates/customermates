model ConnectedAccount {
  id                 String                  @id @default(uuid())
  companyId          String
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  unipileAccountId   String                  @unique
  provider           MessagingProvider
  status             ConnectedAccountStatus  @default(connecting)
  hasMessaging       Boolean                 @default(false)
  hasCalendar        Boolean                 @default(false)
  emailAddress       String?
  displayName        String?
  sentFolderIds      String[]                @default([])
  folders            Json                    @default("[]")
  selectedFolderIds  String[]                @default([])
  foldersSyncedAt    DateTime?
  linkedinProducts   String[]                @default([])
  shared             Boolean                 @default(false)
  syncing            Boolean                 @default(false)
  ownerAvatarUrl     String?
  lastSyncedAt       DateTime?
  backfillClaimedAt  DateTime?
  backfillClaimToken String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  threads            MessagingThread[]
  messages           MessagingMessage[]
  calendars          Calendar[]
  calendarEvents     CalendarEvent[]
  inboundEvents      MessagingInboundEvent[]
  accountActivities  AccountActivity[]

  @@index([companyId])
  @@index([userId])
  @@index([companyId, provider])
}

model MessagingThread {
  id                  String                       @id @default(uuid())
  companyId           String
  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId  String
  connectedAccount    ConnectedAccount             @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  state               MessagingThreadState         @default(unread)
  type                MessagingThreadType          @default(single)
  name                String?
  unipileThreadId     String
  unipileThreadAltId  String?
  provider            MessagingProvider
  subject             String?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  lastMessageIsSender Boolean?
  sharedToCrm         Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  messages            MessagingMessage[]
  participants        MessagingThreadParticipant[]

  @@unique([connectedAccountId, unipileThreadId])
  @@index([companyId])
  @@index([companyId, state])
  @@index([companyId, lastMessageAt(sort: Desc)])
  @@index([companyId, sharedToCrm])
  @@index([connectedAccountId, unipileThreadAltId])
}

model MessagingThreadParticipant {
  id                String            @id @default(uuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingThreadId String
  thread            MessagingThread   @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  provider          MessagingProvider
  providerUserId    String
  identifier        String?
  displayName       String?
  pictureUrl        String?
  profileUrl        String?
  headline          String?
  occupation        String?
  isSelf            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([messagingThreadId, providerUserId])
  @@unique([messagingThreadId, identifier])
  @@index([companyId])
  @@index([messagingThreadId])
  @@index([companyId, provider, identifier])
}

model MessagingMessage {
  id                 String                    @id @default(uuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingThreadId  String
  thread             MessagingThread           @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount          @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  unipileMessageId   String
  providerMessageId  String?
  provider           MessagingProvider
  direction          MessagingMessageDirection
  origin             MessagingMessageOrigin
  sender             Json
  senderIdentifier   String?
  recipients         Json                      @default("{}")
  reactions          Json                      @default("[]")
  subject            String?
  bodyText           String?
  bodyHtml           String?
  attachmentsMeta    Json                      @default("[]")
  folderIds          String[]                  @default([])
  isEvent            Boolean                   @default(false)
  isDeleted          Boolean                   @default(false)
  isHidden           Boolean                   @default(false)
  isDraft            Boolean                   @default(false)
  sentAt             DateTime
  editedAt           DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([connectedAccountId, unipileMessageId])
  @@index([companyId])
  @@index([messagingThreadId, sentAt])
  @@index([companyId, provider, senderIdentifier])
  @@index([folderIds], type: Gin)
}

model AccountActivity {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  identifier         String?
  kind               AccountActivityKind
  payload            Json                @default("{}")
  occurredAt         DateTime
  createdAt          DateTime            @default(now())

  @@unique([connectedAccountId, kind, identifier])
  @@index([companyId, occurredAt])
  @@index([companyId, identifier])
}

enum MessagingProvider {
  google
  outlook
  mail
  linkedin
  whatsapp
  instagram
  telegram
}

enum ConnectedAccountStatus {
  ok
  connecting
  credentials
  permissions
  error
  stopped
  deleted
}

enum MessagingMessageDirection {
  inbound
  outbound
}

enum MessagingMessageOrigin {
  unipile
  external
}

enum AccountActivityKind {
  linkedin_connection_accepted
}

model ContactIdentifier {
  id           String            @id @default(uuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider     MessagingProvider
  channelClass String
  value        String
  messagingId  String?
  displayName  String?
  profileUrl   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([companyId, channelClass, value])
  @@unique([companyId, provider, messagingId])
  @@index([contactId])
}

model Calendar {
  id                 String           @id @default(uuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  unipileCalendarId  String
  name               String
  description        String?
  color              String?
  timezone           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  events             CalendarEvent[]

  @@unique([connectedAccountId, unipileCalendarId])
  @@index([companyId])
}

model CalendarEvent {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  calendarId         String
  calendar           Calendar            @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  unipileEventId     String
  title              String
  description        String?
  location           String?
  conferenceUrl      String?
  startsAt           DateTime
  endsAt             DateTime
  allDay             Boolean             @default(false)
  timezone           String?
  recurrenceRule     String?
  status             CalendarEventStatus @default(confirmed)
  visibility         String?
  attendees          Json                @default("[]")
  organizer          Json?
  attendeeEmails     String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([connectedAccountId, unipileEventId])
  @@index([companyId, startsAt])
  @@index([attendeeEmails], type: Gin)
}

enum CalendarEventStatus {
  confirmed
  cancelled
}

model MessagingInboundEvent {
  id                 String                      @id @default(uuid())
  companyId          String?
  connectedAccountId String?
  connectedAccount   ConnectedAccount?           @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  source             MessagingInboundEventSource
  unipileMessageId   String?
  payload            Json
  processed          Boolean                     @default(false)
  error              String?
  lastErrorAt        DateTime?
  attemptCount       Int                         @default(0)
  receivedAt         DateTime                    @default(now())
  processedAt        DateTime?

  @@index([source, processed, receivedAt])
}

enum MessagingInboundEventSource {
  webhook
  backfill
}

enum UnipileWebhookSource {
  account_status
  account_callback
  messaging
  mail
  calendar
  users
}

model SupportTicket {
  id         String              @id @default(uuid())
  number     Int                 @unique @default(autoincrement())
  companyId  String
  userId     String
  subject    String
  body       String
  status     SupportTicketStatus @default(open)
  source     SupportTicketSource
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?

  @@index([companyId, status])
  @@index([status, createdAt])
}

enum SupportTicketStatus {
  open
  resolved
}

enum SupportTicketSource {
  chat
  mcp
}
