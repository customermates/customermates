{
  "id": "tpl_nonprofit_donors_and_members",
  "version": 1,
  "schemaVersion": 1,
  "slug": "nonprofit-donors-and-members",
  "family": "community",
  "kind": "register",
  "jurisdictions": ["DE", "FR", "IT", "ES", "BR", "PL", "NL"],
  "dashboardAudience": "team",
  "modules": ["actions_core", "actions_dashboard"],
  "requiresCapabilities": ["forms", "rules"],
  "pairedPages": {},
  "lists": [
    { "key": "supporters", "role": "people", "icon": "heart" },
    { "key": "memberships", "icon": "idCard" },
    { "key": "gifts", "icon": "gift" },
    { "key": "gift_opportunities", "role": "deals", "icon": "coins" }
  ],
  "stages": [
    {
      "field": "memberships.status",
      "items": [
        { "key": "applied", "outcome": "open", "weight": 0 },
        { "key": "active", "outcome": "won", "weight": 100 },
        { "key": "grace_period", "outcome": "open", "weight": 0 },
        { "key": "lapsed", "outcome": "lost", "weight": 0 },
        { "key": "resigned", "outcome": "lost", "weight": 0 }
      ]
    },
    {
      "field": "gift_opportunities.stage",
      "items": [
        { "key": "identified", "outcome": "open", "weight": 5 },
        { "key": "qualified", "outcome": "open", "weight": 10 },
        { "key": "cultivation", "outcome": "open", "weight": 25 },
        { "key": "ask_made", "outcome": "open", "weight": 50 },
        { "key": "pledged", "outcome": "open", "weight": 85 },
        { "key": "received", "outcome": "won", "weight": 100 },
        { "key": "declined", "outcome": "lost", "weight": 0 }
      ]
    }
  ],
  "fields": [
    { "key": "supporters.member_number", "type": "text" },
    { "key": "supporters.supporter_types", "type": "select", "multiple": true, "options": [{ "key": "member" }, { "key": "donor" }, { "key": "volunteer" }, { "key": "guest" }, { "key": "board_member" }] },
    { "key": "supporters.lifecycle_status", "type": "select", "options": [{ "key": "prospect" }, { "key": "active", "color": "success" }, { "key": "lapsed", "color": "warning" }, { "key": "former", "color": "secondary" }, { "key": "do_not_contact", "color": "destructive" }] },
    { "key": "supporters.joined_on", "type": "date" },
    { "key": "supporters.relationship_owner", "type": "member" },
    { "key": "supporters.contact_consent", "type": "select", "options": [{ "key": "granted", "color": "success" }, { "key": "not_granted", "color": "destructive" }, { "key": "unknown" }] },
    { "key": "supporters.consent_date", "type": "date" },
    { "key": "supporters.last_contact_on", "type": "date" },
    { "key": "memberships.level", "type": "select", "options": [{ "key": "regular" }, { "key": "reduced" }, { "key": "family" }, { "key": "youth" }, { "key": "supporting" }, { "key": "honorary" }] },
    { "key": "memberships.fee", "type": "currency" },
    { "key": "memberships.billing_cycle", "type": "select", "options": [{ "key": "yearly" }, { "key": "quarterly" }, { "key": "monthly" }, { "key": "one_off" }, { "key": "none" }] },
    { "key": "memberships.fee_status", "type": "select", "options": [{ "key": "open" }, { "key": "paid", "color": "success" }, { "key": "reminded", "color": "warning" }, { "key": "overdue", "color": "destructive" }, { "key": "waived", "color": "secondary" }] },
    { "key": "memberships.mandate_on_file", "type": "boolean" },
    { "key": "memberships.started_on", "type": "date" },
    { "key": "memberships.renewal_due", "type": "date" },
    { "key": "memberships.end_reason", "type": "select", "options": [{ "key": "moved_away" }, { "key": "cost" }, { "key": "lost_interest" }, { "key": "dissatisfied" }, { "key": "unpaid_fees" }, { "key": "other" }] },
    { "key": "gifts.received_on", "type": "date" },
    { "key": "gifts.amount", "type": "currency" },
    { "key": "gifts.gift_type", "type": "select", "options": [{ "key": "one_off" }, { "key": "recurring" }, { "key": "pledge_payment" }, { "key": "in_kind" }, { "key": "legacy" }] },
    { "key": "gifts.fund", "type": "select", "options": [{ "key": "unrestricted" }, { "key": "restricted_project" }, { "key": "appeal" }, { "key": "event" }, { "key": "in_memory" }] },
    { "key": "gifts.acknowledgement_status", "type": "select", "options": [{ "key": "to_acknowledge", "color": "warning" }, { "key": "acknowledged", "color": "success" }, { "key": "not_needed", "color": "secondary" }] },
    { "key": "gifts.receipt_status", "type": "select", "options": [{ "key": "not_needed", "color": "secondary" }, { "key": "to_issue", "color": "warning" }, { "key": "issued", "color": "success" }, { "key": "annual_summary_sent", "color": "success" }] },
    { "key": "gift_opportunities.kind", "type": "select", "options": [{ "key": "major_gift" }, { "key": "grant" }, { "key": "sponsorship" }, { "key": "legacy" }, { "key": "campaign_pledge" }] },
    { "key": "gift_opportunities.solicitor", "type": "member" },
    { "key": "gift_opportunities.ask_date", "type": "date" },
    { "key": "gift_opportunities.decision_on", "type": "date" },
    { "key": "gift_opportunities.report_due", "type": "date" },
    { "key": "actions.kind", "type": "select", "options": [{ "key": "thank_donor" }, { "key": "issue_receipt" }, { "key": "welcome_member" }, { "key": "renewal_notice" }, { "key": "chase_fee" }, { "key": "ask" }, { "key": "report_to_funder" }, { "key": "call_or_visit" }, { "key": "other" }] }
  ],
  "relationships": [
    { "key": "membership_supporter", "source": "memberships", "target": "supporters", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "gift_supporter", "source": "gifts", "target": "supporters", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "opportunity_supporter", "source": "gift_opportunities", "target": "supporters", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_supporter", "source": "actions", "target": "supporters", "sourceCardinality": "one", "targetCardinality": "many" }
  ],
  "views": [
    { "key": "supporters_all", "list": "supporters", "default": true, "layout": "table", "columns": ["supporters.supporter_types", "supporters.lifecycle_status", "supporters.relationship_owner", "supporters.last_contact_on"] },
    { "key": "memberships_all", "list": "memberships", "default": true, "layout": "table", "sort": { "field": "memberships.renewal_due", "direction": "asc" }, "columns": ["memberships.status", "memberships.level", "memberships.fee", "memberships.fee_status", "memberships.renewal_due"] },
    { "key": "memberships_board", "list": "memberships", "default": false, "layout": "board", "groupBy": "memberships.status" },
    {
      "key": "fees_to_chase",
      "list": "memberships",
      "default": false,
      "layout": "table",
      "filters": [
        { "operator": "in", "field": "memberships.status", "options": ["active", "grace_period"] },
        { "operator": "in", "field": "memberships.fee_status", "options": ["open", "reminded", "overdue"] }
      ]
    },
    { "key": "gifts_all", "list": "gifts", "default": true, "layout": "table", "sort": { "field": "gifts.received_on", "direction": "desc" }, "columns": ["gifts.received_on", "gifts.amount", "gifts.fund", "gifts.receipt_status"] },
    { "key": "receipts_to_issue", "list": "gifts", "default": false, "layout": "table", "filters": [{ "operator": "in", "field": "gifts.receipt_status", "options": ["to_issue"] }] },
    { "key": "opportunities_board", "list": "gift_opportunities", "default": true, "layout": "board", "groupBy": "gift_opportunities.stage" }
  ],
  "widgets": [
    { "kind": "chart", "key": "memberships_by_status", "list": "memberships", "aggregation": "count", "groupBy": { "field": "memberships.status" }, "display": "doughnutChart" },
    { "kind": "chart", "key": "gifts_per_month", "list": "gifts", "aggregation": "sum", "valueField": "gifts.amount", "groupBy": { "field": "gifts.received_on", "dateInterval": "month" }, "display": "areaChart" },
    { "kind": "chart", "key": "gifts_by_fund", "list": "gifts", "aggregation": "sum", "valueField": "gifts.amount", "groupBy": { "field": "gifts.fund" }, "display": "verticalBarChart" },
    {
      "kind": "chart",
      "key": "open_pipeline_value",
      "list": "gift_opportunities",
      "aggregation": "sum",
      "valueField": "gift_opportunities.value",
      "filters": [{ "operator": "notIn", "field": "gift_opportunities.stage", "options": ["received", "declined"] }],
      "display": "number"
    },
    { "kind": "calendar", "key": "renewals_coming", "list": "memberships", "layout": "upcoming", "dateField": "memberships.renewal_due" },
    { "kind": "chart", "key": "receipts_to_issue_count", "list": "gifts", "aggregation": "count", "filters": [{ "operator": "in", "field": "gifts.receipt_status", "options": ["to_issue"] }], "display": "number" }
  ],
  "knowledgePages": [
    { "key": "register_rules", "kind": "overview" },
    { "key": "renewals_and_fees", "kind": "processes" },
    { "key": "receipts_and_thanks", "kind": "processes" }
  ],
  "followUpRules": [
    { "key": "thank_donor", "trigger": { "kind": "record_created", "list": "gifts" }, "action": { "kind": "create_task", "taskKind": "thank_donor", "assignee": "workspace_owner", "about": "gifts" }, "dueOffsetDays": 2, "needs": "today" },
    { "key": "issue_receipt", "trigger": { "kind": "field_changed", "field": "gifts.receipt_status", "to": "to_issue" }, "action": { "kind": "create_task", "taskKind": "issue_receipt", "assignee": "workspace_owner", "about": "gifts" }, "dueOffsetDays": 14, "needs": "today" },
    { "key": "welcome_member", "trigger": { "kind": "field_changed", "field": "memberships.status", "to": "applied" }, "action": { "kind": "create_task", "taskKind": "welcome_member", "assignee": "workspace_owner", "about": "memberships" }, "dueOffsetDays": 3, "needs": "today" },
    {
      "key": "renewal_notice",
      "trigger": { "kind": "date_reached", "field": "memberships.renewal_due", "offsetDays": -60 },
      "condition": [{ "operator": "in", "field": "memberships.status", "options": ["active"] }],
      "action": { "kind": "create_task", "taskKind": "renewal_notice", "assignee": "workspace_owner", "about": "memberships" },
      "dueOffsetDays": 0,
      "needs": "rules"
    },
    {
      "key": "renewal_reminder",
      "trigger": { "kind": "date_reached", "field": "memberships.renewal_due", "offsetDays": -30 },
      "condition": [{ "operator": "in", "field": "memberships.fee_status", "options": ["open", "reminded"] }],
      "action": { "kind": "create_task", "taskKind": "chase_fee", "assignee": "workspace_owner", "about": "memberships" },
      "dueOffsetDays": 0,
      "needs": "rules"
    },
    {
      "key": "expiry_notice",
      "trigger": { "kind": "date_reached", "field": "memberships.renewal_due", "offsetDays": 0 },
      "condition": [{ "operator": "in", "field": "memberships.fee_status", "options": ["open", "reminded", "overdue"] }],
      "action": { "kind": "create_task", "taskKind": "chase_fee", "assignee": "workspace_owner", "about": "memberships" },
      "dueOffsetDays": 1,
      "needs": "rules"
    },
    { "key": "report_to_funder", "trigger": { "kind": "date_reached", "field": "gift_opportunities.report_due", "offsetDays": -14 }, "action": { "kind": "create_task", "taskKind": "report_to_funder", "assignee": "workspace_owner", "about": "gift_opportunities" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "join_form_records", "trigger": { "kind": "form_submitted", "form": "membership" }, "action": { "kind": "create_records", "lists": ["supporters", "memberships"] }, "dueOffsetDays": 0, "needs": "forms" }
  ],
  "acceptanceChecks": [
    { "key": "status_field", "kind": "field_exists", "ref": "memberships.status" },
    { "key": "renewal_field", "kind": "field_exists", "ref": "memberships.renewal_due" },
    { "key": "receipt_field", "kind": "field_exists", "ref": "gifts.receipt_status" }
  ],
  "sources": [
    { "url": "https://bloomerang.com/blog/moves-management", "checkedOn": "2026-11-12" },
    { "url": "https://www.irs.gov/charities-non-profits/charitable-organizations/charitable-organizations-substantiation-and-disclosure-requirements", "checkedOn": "2026-11-12" },
    { "url": "https://www.whatstheprocessfor.com/blog/first-time-guest-follow-up-church", "checkedOn": "2026-11-12" },
    { "url": "https://www.i4a.com/blog/membership-renewal-email-sequences/", "checkedOn": "2026-11-12" },
    { "url": "https://www.assoconnect.com/blog/4821-recu-fiscal-tout-ce-qu-il-faut-savoir-pour-votre-association", "checkedOn": "2026-11-12" },
    { "url": "https://www.kvk.nl/wetten-en-regels/ga-als-vereniging-goed-om-met-privacy-en-avg/", "checkedOn": "2026-11-12" },
    { "url": "https://www.dr-datenschutz.de/datenschutz-im-verein/", "checkedOn": "2026-11-12" },
    { "url": "https://www.finanzamt.nrw.de/steuerinfos/weitere-themen/vereine-und-stiftungen/zuwendungsbestaetigung", "checkedOn": "2026-11-12" },
    { "url": "https://www.legiscope.com/blog/rodo-stowarzyszenia-fundacje.html", "checkedOn": "2026-11-12" },
    { "url": "https://www.planningcenter.com/people", "checkedOn": "2026-11-12" },
    { "url": "https://www.wildapricot.com/blog/free-membership-database-template", "checkedOn": "2026-11-12" },
    { "url": "https://neonone.com/resources/blog/donor-tracking-spreadsheets/", "checkedOn": "2026-11-12" },
    { "url": "https://www.airtable.com/use-cases/donor-campaign-tracking-nonprofit", "checkedOn": "2026-11-12" },
    { "url": "https://www.verenigingen.nl/ledenadministratie/", "checkedOn": "2026-11-12" }
  ],
  "reviewedAt": "2026-11-12",
  "status": { "en": "draft", "de": "draft", "fr": "draft", "it": "draft", "es": "draft", "pt": "draft", "pl": "draft", "nl": "draft" },
  "publicPage": { "en": "own", "de": "own", "fr": "own", "it": "own", "es": "own", "pt": "own", "pl": "none", "nl": "own" },
  "publishWave": { "en": "hold", "de": "wave2", "fr": "wave1", "it": "wave1", "es": "wave1", "pt": "wave2", "nl": "wave2" }
}
