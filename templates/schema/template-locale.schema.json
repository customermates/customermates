{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locale": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "lists": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "pluralLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 480
          }
        },
        "required": [
          "label",
          "pluralLabel"
        ],
        "additionalProperties": false
      }
    },
    "fields": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "options": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "rangeLabels": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sourceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "targetLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "sourceLabel",
          "targetLabel"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "widgets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "knowledgePages": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sections": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "title",
          "sections"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "acceptanceChecks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "metaTitle": {
          "type": "string",
          "minLength": 30,
          "maxLength": 60
        },
        "metaDescription": {
          "type": "string",
          "minLength": 70,
          "maxLength": 158
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "routine": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "steps": {
              "minItems": 2,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          "required": [
            "title",
            "steps"
          ],
          "additionalProperties": false
        },
        "limits": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "faq": {
          "minItems": 2,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 900
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "metaTitle",
        "metaDescription",
        "headline",
        "answer",
        "routine",
        "limits",
        "faq"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "questions": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "required": [
        "intro",
        "questions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "locale",
    "name",
    "summary",
    "description",
    "prompt"
  ],
  "additionalProperties": false
}
