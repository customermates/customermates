{
  "key": "actions_dashboard",
  "description": "The default Actions view and the three dashboard widgets every follow-up template shows: upcoming Actions, overdue Actions and recent activity. Needs actions_core and a kind field on the Actions list.",
  "views": [
    {
      "key": "actions_all",
      "list": "actions",
      "default": true,
      "layout": "table",
      "sort": { "field": "actions.due", "direction": "asc" },
      "columns": ["actions.due", "actions.status", "actions.kind", "actions.owner"]
    }
  ],
  "widgets": [
    {
      "kind": "calendar",
      "key": "upcoming_actions",
      "list": "actions",
      "layout": "upcoming",
      "dateField": "actions.due",
      "filters": [{ "operator": "in", "field": "actions.status", "options": ["open", "waiting"] }]
    },
    {
      "kind": "chart",
      "key": "overdue_actions",
      "list": "actions",
      "aggregation": "count",
      "filters": [
        { "operator": "in", "field": "actions.status", "options": ["open"] },
        { "operator": "inLastDays", "field": "actions.due", "days": 3650 }
      ],
      "display": "number"
    },
    { "kind": "activity", "key": "activity_timeline" }
  ],
  "text": {
    "en": {
      "views": { "actions_all": { "name": "All actions" } },
      "widgets": {
        "upcoming_actions": { "title": "Upcoming actions" },
        "overdue_actions": { "title": "Overdue actions" },
        "activity_timeline": { "title": "Recent activity" }
      }
    },
    "de": {
      "views": { "actions_all": { "name": "Alle Aufgaben" } },
      "widgets": {
        "upcoming_actions": { "title": "Anstehende Aufgaben" },
        "overdue_actions": { "title": "Überfällige Aufgaben" },
