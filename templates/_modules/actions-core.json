{
  "key": "actions_core",
  "description": "The tasks list every follow-up template shares: an Action with a status, a due date, an owner and an outcome. A template adds its own kind field.",
  "lists": [{ "key": "actions", "role": "tasks", "icon": "check" }],
  "fields": [
    {
      "key": "actions.status",
      "type": "select",
      "options": [{ "key": "open" }, { "key": "waiting", "color": "warning" }, { "key": "done", "color": "success" }, { "key": "cancelled", "color": "secondary" }]
    },
    { "key": "actions.due", "type": "date" },
    { "key": "actions.owner", "type": "member" },
    { "key": "actions.outcome", "type": "richText" }
  ],
  "text": {
    "en": {
