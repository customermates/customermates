{
  "id": "tpl_recruiting_desk",
  "version": 1,
  "schemaVersion": 1,
  "slug": "recruiting-desk",
  "family": "recruiting",
  "kind": "pipeline",
  "jurisdictions": ["DE", "FR", "IT", "ES", "BR", "PL", "NL"],
  "dashboardAudience": "team",
  "modules": ["actions_core", "actions_dashboard"],
  "requiresCapabilities": ["forms", "rules", "calendarWrite", "notifications"],
  "pairedPages": {
    "en": "/for/recruiting",
    "de": "/for/recruiting",
    "fr": "/for/recruiting",
    "it": "/for/recruiting",
    "es": "/for/recruiting",
    "pt": "/for/recruiting",
    "pl": "/for/recruiting",
    "nl": "/for/recruiting"
  },
  "lists": [
    { "key": "people", "role": "people", "icon": "contact" },
    { "key": "clients", "icon": "building" },
    { "key": "jobs", "role": "deals", "icon": "briefcase" },
    { "key": "submissions", "icon": "userCheck" },
    { "key": "placements", "icon": "award" }
  ],
  "stages": [
    {
      "field": "jobs.stage",
      "items": [
        { "key": "lead", "outcome": "open", "weight": 10 },
        { "key": "brief", "outcome": "open", "weight": 25 },
        { "key": "terms_agreed", "outcome": "open", "weight": 40 },
        { "key": "searching", "outcome": "open", "weight": 50 },
        { "key": "submitted", "outcome": "open", "weight": 65 },
        { "key": "interviews", "outcome": "open", "weight": 80 },
        { "key": "offer", "outcome": "open", "weight": 90 },
        { "key": "placed", "outcome": "won", "weight": 100 },
        { "key": "lost", "outcome": "lost", "weight": 0 }
      ]
    },
    {
      "field": "submissions.stage",
      "items": [
        { "key": "sourced", "outcome": "open", "weight": 5 },
        { "key": "contacted", "outcome": "open", "weight": 10 },
        { "key": "screened", "outcome": "open", "weight": 20 },
        { "key": "submitted", "outcome": "open", "weight": 35 },
        { "key": "client_interview", "outcome": "open", "weight": 55 },
        { "key": "offer", "outcome": "open", "weight": 80 },
        { "key": "placed", "outcome": "won", "weight": 100 },
        { "key": "rejected_internal", "outcome": "lost", "weight": 0 },
        { "key": "rejected_by_client", "outcome": "lost", "weight": 0 },
        { "key": "withdrawn", "outcome": "lost", "weight": 0 }
      ]
    }
  ],
  "fields": [
    { "key": "people.person_type", "type": "select", "options": [{ "key": "candidate" }, { "key": "client_contact" }, { "key": "referrer" }, { "key": "other" }] },
    { "key": "people.job_title", "type": "text" },
    { "key": "people.candidate_status", "type": "select", "options": [{ "key": "active", "color": "success" }, { "key": "passive" }, { "key": "placed", "color": "success" }, { "key": "do_not_contact", "color": "destructive" }, { "key": "archived", "color": "secondary" }] },
    { "key": "people.source", "type": "select", "options": [{ "key": "referral" }, { "key": "linkedin" }, { "key": "job_board" }, { "key": "own_database" }, { "key": "event" }, { "key": "inbound" }, { "key": "other" }] },
    { "key": "people.salary_expectation", "type": "currency" },
    { "key": "people.notice_period", "type": "text" },
    { "key": "people.location", "type": "text" },
    { "key": "people.data_basis", "type": "select", "options": [{ "key": "pre_contract" }, { "key": "talent_pool_consent" }, { "key": "legitimate_interest" }] },
    { "key": "people.retain_until", "type": "date" },
    { "key": "people.last_contact", "type": "date" },
    { "key": "people.owner", "type": "member" },
    { "key": "clients.client_status", "type": "select", "options": [{ "key": "prospect" }, { "key": "active_client", "color": "success" }, { "key": "past_client", "color": "secondary" }, { "key": "do_not_contact", "color": "destructive" }] },
    { "key": "clients.agreement_type", "type": "select", "options": [{ "key": "contingency" }, { "key": "retained" }, { "key": "container" }, { "key": "other" }] },
    { "key": "clients.fee_percent", "type": "number" },
    { "key": "clients.guarantee_days", "type": "number" },
    { "key": "clients.terms_signed_on", "type": "date" },
    { "key": "clients.terms_url", "type": "url" },
    { "key": "clients.website", "type": "url" },
    { "key": "clients.next_touch", "type": "date" },
    { "key": "clients.owner", "type": "member" },
    { "key": "jobs.salary", "type": "currency" },
    { "key": "jobs.fee_percent", "type": "number" },
    { "key": "jobs.opened_on", "type": "date" },
    { "key": "jobs.filled_on", "type": "date" },
    { "key": "jobs.exclusive", "type": "boolean" },
    { "key": "jobs.location", "type": "text" },
    { "key": "jobs.work_model", "type": "select", "options": [{ "key": "on_site" }, { "key": "hybrid" }, { "key": "remote" }] },
    { "key": "jobs.must_haves", "type": "richText" },
    { "key": "jobs.brief_url", "type": "url" },
    { "key": "jobs.next_step", "type": "text" },
    { "key": "jobs.next_step_due", "type": "date" },
    { "key": "jobs.lost_reason", "type": "select", "options": [{ "key": "client_filled_internally" }, { "key": "client_froze_search" }, { "key": "filled_by_competitor" }, { "key": "terms_not_agreed" }, { "key": "role_cancelled" }, { "key": "no_suitable_candidates" }] },
    { "key": "jobs.owner", "type": "member" },
    { "key": "submissions.submitted_on", "type": "date" },
    { "key": "submissions.interview_at", "type": "dateTime" },
    { "key": "submissions.feedback_due", "type": "date" },
    { "key": "submissions.rejection_reason", "type": "select", "options": [{ "key": "skills" }, { "key": "culture_fit" }, { "key": "salary_mismatch" }, { "key": "other_offer" }, { "key": "no_response" }, { "key": "location_or_notice" }] },
    { "key": "submissions.notes", "type": "richText" },
    { "key": "submissions.owner", "type": "member" },
    { "key": "placements.start_date", "type": "date" },
    { "key": "placements.agreed_salary", "type": "currency" },
    { "key": "placements.fee_amount", "type": "currency" },
    { "key": "placements.invoice_reference", "type": "text" },
    { "key": "placements.guarantee_ends", "type": "date" },
    { "key": "placements.status", "type": "select", "options": [{ "key": "in_guarantee", "color": "warning" }, { "key": "guarantee_passed", "color": "success" }, { "key": "fell_out_replaced" }, { "key": "fell_out_refunded", "color": "destructive" }] },
    { "key": "actions.kind", "type": "select", "options": [{ "key": "call_client" }, { "key": "call_candidate" }, { "key": "submit_candidate" }, { "key": "request_feedback" }, { "key": "prepare_interview" }, { "key": "debrief" }, { "key": "chase_terms" }, { "key": "check_in" }, { "key": "retention_review" }, { "key": "review_search" }, { "key": "invoice_request" }, { "key": "other" }] }
  ],
  "calculations": [
    { "key": "jobs.days_to_fill", "type": "number", "expression": { "op": "daysBetween", "from": "jobs.opened_on", "to": "jobs.filled_on" } },
    {
      "key": "jobs.weighted_fee",
      "type": "currency",
      "expression": {
        "op": "divide",
        "left": { "op": "multiply", "left": { "op": "field", "field": "jobs.value" }, "right": { "op": "optionWeight", "field": "jobs.stage" } },
        "right": { "op": "number", "value": "100" }
      }
    }
  ],
  "relationships": [
    { "key": "person_client", "source": "people", "target": "clients", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "job_client", "source": "jobs", "target": "clients", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "job_contacts", "source": "jobs", "target": "people", "sourceCardinality": "many", "targetCardinality": "many" },
    { "key": "submission_job", "source": "submissions", "target": "jobs", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "submission_candidate", "source": "submissions", "target": "people", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "placement_job", "source": "placements", "target": "jobs", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "placement_candidate", "source": "placements", "target": "people", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_person", "source": "actions", "target": "people", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_job", "source": "actions", "target": "jobs", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_submission", "source": "actions", "target": "submissions", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_client", "source": "actions", "target": "clients", "sourceCardinality": "one", "targetCardinality": "many" },
    { "key": "action_placement", "source": "actions", "target": "placements", "sourceCardinality": "one", "targetCardinality": "many" }
  ],
  "views": [
    { "key": "jobs_board", "list": "jobs", "default": true, "layout": "board", "groupBy": "jobs.stage", "sort": { "field": "jobs.next_step_due", "direction": "asc" }, "columns": ["jobs.salary", "jobs.fee_percent", "jobs.next_step_due"], "summaries": [{ "field": "jobs.value", "aggregation": "sum" }] },
    { "key": "jobs_all", "list": "jobs", "default": false, "layout": "table", "sort": { "field": "jobs.next_step_due", "direction": "asc" }, "columns": ["jobs.stage", "jobs.owner", "jobs.salary", "jobs.fee_percent", "jobs.opened_on", "jobs.next_step_due"] },
    { "key": "searches_without_next_step", "list": "jobs", "default": false, "layout": "table", "filters": [{ "operator": "notIn", "field": "jobs.stage", "options": ["placed", "lost"] }, { "operator": "empty", "field": "jobs.next_step_due" }] },
    { "key": "submissions_board", "list": "submissions", "default": true, "layout": "board", "groupBy": "submissions.stage", "sort": { "field": "submissions.feedback_due", "direction": "asc" }, "columns": ["submissions.submitted_on", "submissions.interview_at", "submissions.feedback_due"] },
    { "key": "feedback_pending", "list": "submissions", "default": false, "layout": "table", "sort": { "field": "submissions.feedback_due", "direction": "asc" }, "filters": [{ "operator": "in", "field": "submissions.stage", "options": ["submitted", "client_interview"] }] },
    { "key": "placements_all", "list": "placements", "default": true, "layout": "table", "sort": { "field": "placements.guarantee_ends", "direction": "asc" }, "columns": ["placements.status", "placements.start_date", "placements.fee_amount", "placements.guarantee_ends"] },
    { "key": "clients_all", "list": "clients", "default": true, "layout": "table", "sort": { "field": "clients.next_touch", "direction": "asc" }, "columns": ["clients.client_status", "clients.agreement_type", "clients.fee_percent", "clients.guarantee_days", "clients.next_touch"] },
    { "key": "people_all", "list": "people", "default": true, "layout": "table", "columns": ["people.person_type", "people.candidate_status", "people.job_title", "people.location", "people.retain_until"] }
  ],
  "widgets": [
    { "kind": "chart", "key": "jobs_funnel", "list": "jobs", "aggregation": "count", "groupBy": { "field": "jobs.stage" }, "filters": [{ "operator": "notIn", "field": "jobs.stage", "options": ["placed", "lost"] }], "display": "funnelChart", "size": "large" },
    { "kind": "chart", "key": "weighted_fees", "list": "jobs", "aggregation": "sum", "valueField": "jobs.weighted_fee", "filters": [{ "operator": "notIn", "field": "jobs.stage", "options": ["placed", "lost"] }], "display": "number" },
    { "kind": "chart", "key": "submissions_by_stage", "list": "submissions", "aggregation": "count", "groupBy": { "field": "submissions.stage" }, "display": "horizontalBarChart" },
    { "kind": "chart", "key": "placements_per_month", "list": "placements", "aggregation": "sum", "valueField": "placements.fee_amount", "groupBy": { "field": "placements.start_date", "dateInterval": "month" }, "display": "areaChart" },
    { "kind": "calendar", "key": "interviews_coming", "list": "submissions", "layout": "upcoming", "dateField": "submissions.interview_at" },
    { "kind": "calendar", "key": "guarantees_ending", "list": "placements", "layout": "upcoming", "dateField": "placements.guarantee_ends", "filters": [{ "operator": "in", "field": "placements.status", "options": ["in_guarantee"] }] },
    { "kind": "calendar", "key": "retention_due", "list": "people", "layout": "upcoming", "dateField": "people.retain_until" },
    { "kind": "chart", "key": "lost_reasons", "list": "jobs", "aggregation": "count", "groupBy": { "field": "jobs.lost_reason" }, "filters": [{ "operator": "in", "field": "jobs.stage", "options": ["lost"] }], "display": "doughnutChart" },
    { "kind": "chart", "key": "average_days_to_fill", "list": "jobs", "aggregation": "average", "valueField": "jobs.days_to_fill", "display": "number" }
  ],
  "knowledgePages": [
    { "key": "operating_guide", "kind": "overview" },
    { "key": "client_intake_call", "kind": "salesPlaybook" },
    { "key": "terms_checklist", "kind": "processes" },
    { "key": "screening_call", "kind": "salesPlaybook" },
    { "key": "submission_email", "kind": "salesPlaybook" },
    { "key": "interview_routine", "kind": "processes" },
    { "key": "candidate_data", "kind": "processes" },
    { "key": "aftercare_routine", "kind": "processes" }
  ],
  "followUpRules": [
    { "key": "chase_terms", "trigger": { "kind": "field_changed", "field": "jobs.stage", "to": "terms_agreed" }, "action": { "kind": "create_task", "taskKind": "chase_terms", "assignee": "record_owner", "about": "jobs" }, "dueOffsetDays": 3, "needs": "rules" },
    { "key": "request_client_feedback", "trigger": { "kind": "field_changed", "field": "submissions.stage", "to": "submitted" }, "action": { "kind": "create_task", "taskKind": "request_feedback", "assignee": "record_owner", "about": "submissions" }, "dueOffsetDays": 2, "needs": "rules" },
    { "key": "prepare_interview", "trigger": { "kind": "date_reached", "field": "submissions.interview_at", "offsetDays": -1 }, "condition": [{ "operator": "in", "field": "submissions.stage", "options": ["client_interview"] }], "action": { "kind": "create_task", "taskKind": "prepare_interview", "assignee": "record_owner", "about": "submissions" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "debrief_interview", "trigger": { "kind": "date_reached", "field": "submissions.interview_at", "offsetDays": 0 }, "condition": [{ "operator": "in", "field": "submissions.stage", "options": ["client_interview"] }], "action": { "kind": "create_task", "taskKind": "debrief", "assignee": "record_owner", "about": "submissions" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "chase_offer_decision", "trigger": { "kind": "field_changed", "field": "submissions.stage", "to": "offer" }, "action": { "kind": "create_task", "taskKind": "call_candidate", "assignee": "record_owner", "about": "submissions" }, "dueOffsetDays": 2, "needs": "rules" },
    { "key": "start_day_confirmation", "trigger": { "kind": "date_reached", "field": "placements.start_date", "offsetDays": 0 }, "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "check_in_week_1", "trigger": { "kind": "date_reached", "field": "placements.start_date", "offsetDays": 7 }, "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "check_in_day_30", "trigger": { "kind": "date_reached", "field": "placements.start_date", "offsetDays": 30 }, "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "check_in_day_60", "trigger": { "kind": "date_reached", "field": "placements.start_date", "offsetDays": 60 }, "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "check_in_day_90", "trigger": { "kind": "date_reached", "field": "placements.start_date", "offsetDays": 90 }, "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "guarantee_check", "trigger": { "kind": "date_reached", "field": "placements.guarantee_ends", "offsetDays": -14 }, "condition": [{ "operator": "in", "field": "placements.status", "options": ["in_guarantee"] }], "action": { "kind": "create_task", "taskKind": "check_in", "assignee": "record_owner", "about": "placements" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "retention_review", "trigger": { "kind": "date_reached", "field": "people.retain_until", "offsetDays": 0 }, "condition": [{ "operator": "notIn", "field": "people.candidate_status", "options": ["placed"] }], "action": { "kind": "create_task", "taskKind": "retention_review", "assignee": "record_owner", "about": "people" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "client_touch", "trigger": { "kind": "date_reached", "field": "clients.next_touch", "offsetDays": 0 }, "condition": [{ "operator": "in", "field": "clients.client_status", "options": ["active_client"] }], "action": { "kind": "create_task", "taskKind": "call_client", "assignee": "record_owner", "about": "clients" }, "dueOffsetDays": 0, "needs": "rules" },
    { "key": "stalled_search_review", "trigger": { "kind": "schedule", "every": "week", "weekday": 1, "list": "jobs" }, "condition": [{ "operator": "in", "field": "jobs.stage", "options": ["searching", "submitted"] }, { "operator": "olderThanDays", "field": "jobs.opened_on", "days": 10 }], "action": { "kind": "create_task", "taskKind": "review_search", "assignee": "record_owner", "about": "jobs" }, "dueOffsetDays": 0, "needs": "today" },
    { "key": "application_received", "trigger": { "kind": "form_submitted", "form": "application" }, "action": { "kind": "create_records", "lists": ["people", "actions"] }, "dueOffsetDays": 1, "needs": "forms" },
    { "key": "feedback_overdue_notice", "trigger": { "kind": "date_reached", "field": "submissions.feedback_due", "offsetDays": 0 }, "condition": [{ "operator": "in", "field": "submissions.stage", "options": ["submitted"] }], "action": { "kind": "notify", "recipient": "record_owner" }, "dueOffsetDays": 0, "needs": "notifications" },
    { "key": "interview_calendar", "trigger": { "kind": "field_changed", "field": "submissions.stage", "to": "client_interview" }, "action": { "kind": "add_calendar_event", "dateField": "submissions.interview_at" }, "dueOffsetDays": 0, "needs": "calendarWrite" }
  ],
  "acceptanceChecks": [
    { "key": "job_stage_field", "kind": "field_exists", "ref": "jobs.stage" },
    { "key": "submission_stage_field", "kind": "field_exists", "ref": "submissions.stage" },
    { "key": "guarantee_end_field", "kind": "field_exists", "ref": "placements.guarantee_ends" },
    { "key": "retain_until_field", "kind": "field_exists", "ref": "people.retain_until" },
    { "key": "jobs_board_view", "kind": "view_exists", "ref": "jobs_board" },
    { "key": "candidate_data_page", "kind": "page_exists", "ref": "candidate_data" }
  ],
  "sources": [
    { "url": "https://kb.bullhorn.com/ats/Content/BHATS/Topics/understandingBHHiringProcess.htm", "checkedOn": "2026-11-12" },
    { "url": "https://help.recruiterflow.com/en/articles/5781968-stage-categories-in-recruiterflow-what-they-are-and-why-they-matter", "checkedOn": "2026-11-12" },
    { "url": "https://www.bitrix24.com/tools/crm/industries/crm-for-staffing-agencies.php", "checkedOn": "2026-11-12" },
    { "url": "https://www.craftt.io/attio-for-recruiting", "checkedOn": "2026-11-12" },
    { "url": "https://ico.org.uk/for-organisations/uk-gdpr-guidance-and-resources/employment/recruitment-and-selection/keeping-recruitment-records/", "checkedOn": "2026-11-12" },
    { "url": "https://www.dr-datenschutz.de/die-aufbewahrungsfristen-von-bewerberdaten/", "checkedOn": "2026-11-12" },
    { "url": "https://www.fachanwalt.de/ratgeber/personalvermittlung-und-provisionsanspruch", "checkedOn": "2026-11-12" },
    { "url": "https://www.leonar.app/fr/blog/retained-vs-contingency-recruitment/", "checkedOn": "2026-11-12" },
    { "url": "https://zielonalinia.gov.pl/wpis-do-rejestru-agencji-zatrudnienia-co-warto-wiedziec/", "checkedOn": "2026-11-12" },
    { "url": "https://resources.workable.com/tutorial/gdpr-compliance-guide-recruiting", "checkedOn": "2026-11-12" }
  ],
  "reviewedAt": "2026-11-12",
