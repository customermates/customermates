import fs from 'node:fs'
import { compile } from '@mdx-js/mdx'
import { t as applyMdxPreset } from './node_modules/fumadocs-mdx/dist/preset-Y6J6llIV.js'
import { visit } from 'unist-util-visit'

function rehypeFaqAccordion() {
  return (tree) => {
    let n = 0
    visit(tree, 'element', (node, idx, parent) => {
      if (node.tagName !== 'h2' || !parent) return
      const text = JSON.stringify(node.children)
      if (!/Fragen|questions|Questions|FAQ/.test(text)) return
      const start = idx
      let end = parent.children.length
      for (let i = start + 1; i < parent.children.length; i++) {
        const c = parent.children[i]
        if (c.type === 'element' && /^h[12]$/.test(c.tagName)) { end = i; break }
      }
      const body = parent.children.slice(start + 1, end)
      const items = []
      let cur = null
      for (const c of body) {
        if (c.type === 'element' && c.tagName === 'h3') {
          cur = { type: 'element', tagName: 'FaqItem', properties: { anchorId: c.properties.id, question: JSON.stringify(c.children) }, children: [] }
          items.push(cur)
        } else if (cur) cur.children.push(c)
      }
      if (!items.length) return
      const wrap = { type: 'element', tagName: 'FaqAccordion', properties: {}, children: items }
      parent.children.splice(start + 1, end - start - 1, wrap)
      n++
      return 'skip'
    })
    if (n) tree.__faq = n
  }
}

const opts = await applyMdxPreset({ rehypePlugins: (v) => [...v, rehypeFaqAccordion] })('bundler')
console.log('remark chain length', opts.remarkPlugins.length)
console.log('rehype chain:', opts.rehypePlugins.map(p => Array.isArray(p) ? (p[0].name||'anon') : (p.name||'anon')).join(' -> '))

const raw = fs.readFileSync('content/compare-pages/de/attio.mdx','utf8').replace(/^---\n[\s\S]*?\n---\n/,'')
const out = String(await compile(raw, { ...opts, outputFormat: 'function-body', development: false }))
fs.writeFileSync('.tmp-review/out.js', out)
console.log('--- contains FaqAccordion:', out.includes('FaqAccordion'))
console.log('--- toc export present:', /const toc\s*=|toc =/.test(out))
const m = out.match(/const toc = (\[[\s\S]*?\n\];)/)
console.log('--- toc entries with depth 3:', (out.match(/depth: 3/g)||[]).length)
console.log('--- toc entries with depth 2:', (out.match(/depth: 2/g)||[]).length)
