APP_PORT=4000
APP_MODE=self-hosted

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=customermates

BASE_URL=http://localhost:4000

BETTER_AUTH_SECRET=change-this-to-a-long-random-secret

# Secret for the scheduled maintenance calls, such as the daily /api/cron/lifecycle that empties
# expired Trash; generate it with: openssl rand -hex 32. Without it those calls answer 401.
# CRON_SECRET=

RESEND_API_KEY="XXX"
RESEND_OPERATOR_EMAIL=mail@your-company.com

# Optional: file fields store their files in this database by default. Set s3 to use an S3-compatible bucket
# (back it up separately); uploads above FILE_MAX_UPLOAD_BYTES (default 26214400, 25 MB) are refused.
# FILE_STORAGE_DRIVER=
# FILE_MAX_UPLOAD_BYTES=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=

# Optional: address suggestions from a Photon service, such as https://photon.komoot.io or your own container.
# Unset keeps lookup off and nothing leaves your server.
# ADDRESS_LOOKUP_URL=

# Optional: show "Continue with Google / Microsoft" on sign-in and "Register with Google / Microsoft" on sign-up
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
